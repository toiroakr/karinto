{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Top-level config is what PR preview Workers deploy against
	// (`wrangler deploy --env="" --name karinto-pr-<N>`). It intentionally
	// omits `r2_buckets` so previews can't write into the captures bucket,
	// and omits `triggers` so previews don't all run the daily /meta cron
	// (production refreshes the shared KV for everyone). KV + per-IP rate
	// limit ARE included so previews stay protected and can read the
	// cached GitHub Actions IP list.
	//
	// Production must be deployed via `wrangler deploy --env production`
	// so the CAPTURES binding and cron trigger are attached.
	"name": "karinto",
	"main": "index.js",
	"compatibility_date": "2026-05-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Per-IP rate limit. Skipped for GitHub-hosted Actions runners (their
	// egress IPs are loaded from the /meta list cached in KV below), so a
	// noisy CI tenant can't get unrelated CI traffic 429'd as collateral.
	"unsafe": {
		"bindings": [
			{
				"name": "RATE_LIMITER_IP",
				"type": "ratelimit",
				"namespace_id": "1002",
				"simple": {
					"limit": 60,
					"period": 60
				}
			}
		]
	},
	// KV holds the cached `api.github.com/meta` payload. Production's cron
	// refreshes it daily; request path reads from KV (with a one-shot
	// direct-fetch fallback for the cold-deploy case before the first cron).
	// Shared by all envs — the data is the GitHub-published public IP list.
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "3220fa5aa95f45c4a4816a8f5b0a382e",
			"remote": true
		}
	],
	// D1 worklist for the archived-uses sweep. The request path enqueues seen
	// `uses:` repos into the `pending` table; the production cron drains it.
	// Shared across envs like KV. Provision once and fill `database_id` (see
	// DEVELOPMENT.md): `wrangler d1 create karinto-archived` then
	// `wrangler d1 migrations apply karinto-archived --remote`.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "karinto-archived",
			"database_id": "REPLACE_WITH_D1_DATABASE_ID",
			"remote": true
		}
	],
	// Named envs do NOT inherit `kv_namespaces`, `unsafe`, `triggers`, or
	// `r2_buckets` from the top-level config, so we duplicate them here.
	// KV id is shared because the /meta payload is GitHub-published and
	// identical for every env; the rate-limit namespace_id is distinct for
	// staging so its traffic can't burn the prod token bucket.
	"env": {
		"production": {
			"name": "karinto",
			"unsafe": {
				"bindings": [
					{
						"name": "RATE_LIMITER_IP",
						"type": "ratelimit",
						"namespace_id": "1002",
						"simple": {
							"limit": 60,
							"period": 60
						}
					}
				]
			},
			"kv_namespaces": [
				{
					"binding": "KV",
					"id": "3220fa5aa95f45c4a4816a8f5b0a382e",
					"remote": true
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "karinto-archived",
					"database_id": "REPLACE_WITH_D1_DATABASE_ID",
					"remote": true
				}
			],
			"triggers": {
				"crons": [
					"0 2 * * *"
				]
			},
			"r2_buckets": [
				{
					"binding": "CAPTURES",
					"bucket_name": "karinto-captures"
				}
			]
		},
		"staging": {
			"name": "karinto-staging",
			"unsafe": {
				"bindings": [
					{
						"name": "RATE_LIMITER_IP",
						"type": "ratelimit",
						"namespace_id": "1003",
						"simple": {
							"limit": 60,
							"period": 60
						}
					}
				]
			},
			"kv_namespaces": [
				{
					"binding": "KV",
					"id": "3220fa5aa95f45c4a4816a8f5b0a382e",
					"remote": true
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "karinto-archived",
					"database_id": "REPLACE_WITH_D1_DATABASE_ID",
					"remote": true
				}
			],
			"triggers": {
				"crons": [
					"0 2 * * *"
				]
			}
		}
	}
}
